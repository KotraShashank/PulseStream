# Local services
MONGODB_URI=mongodb://127.0.0.1:27017/pulsestream
REDIS_URL=redis://127.0.0.1:6379
FRONTEND_URL=http://localhost:5173
# Set a private, randomly generated value in production.
JWT_SECRET=
# Optional local admin seed. Use an address you control and a unique password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Email delivery and recovery require an SMTP account.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
